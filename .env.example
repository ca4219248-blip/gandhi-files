# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Public anon key (safe for the browser, used for read-only public queries)
SUPABASE_ANON_KEY=

# Service role key. SERVER SIDE ONLY. It bypasses row level security, so it
# must never be printed, logged, or sent to a browser.
SUPABASE_SERVICE_KEY=

# Storage bucket that holds the PDFs (created by sql/001_schema.sql)
SUPABASE_BUCKET=pra-documents

# Site identity
SITE_NAME=Public Records Archive
SITE_TAGLINE=A sourced archive of public documents
CONTACT_EMAIL=

# Optional absolute URLs, used only for canonical links and the admin <-> site
# links. Leave blank for relative links (single domain installs).
SITE_URL=
ADMIN_URL=

# Listing and storage behaviour
PER_PAGE=10
SIGNED_URL_TTL=900
